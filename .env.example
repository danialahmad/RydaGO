# Copy to `.env` (git-ignored) only if you need to change something. Every value has a
# working dev default, so a fresh clone runs with no .env at all.

# Set to 0.0.0.0 so a phone on the same Wi-Fi can open http://<your-pc-ip>:8080
# (also open the ports in your firewall, see docs/DEVELOPMENT.md). Default: this PC only.
BIND_ADDR=127.0.0.1

# Host port for the web app.
WEB_PORT=8080

# Change these for anything other than your own laptop. JWT_SECRET must be 32+ characters.
POSTGRES_PASSWORD=wazedev
NOMINATIM_PASSWORD=nominatim-dev-only
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# "address" (fast) or "full" (also shops, mosques, malls; ~3x time and disk).
# Only applies on a fresh Nominatim data volume.
NOMINATIM_IMPORT_STYLE=address
